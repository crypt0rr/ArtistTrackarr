{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep the Go toolchain aligned across module, Docker, and CI",
      "groupName": "Go toolchain",
      "matchManagers": [
        "gomod",
        "dockerfile",
        "github-actions"
      ],
      "matchPackageNames": [
        "go",
        "golang",
        "docker.io/library/golang",
        "actions/setup-go",
        "actions/go-versions"
      ]
    },
    {
      "description": "Group pinned Go quality tooling updates",
      "groupName": "Go quality tooling",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/v2",
        "golang.org/x/vuln"
      ]
    }
  ]
}
