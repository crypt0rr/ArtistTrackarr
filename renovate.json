{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep the Go toolchain aligned across module, Docker, and CI",
      "groupName": "Go toolchain",
      "matchManagers": [
        "gomod",
        "dockerfile",
        "github-actions"
      ],
      "matchPackageNames": [
        "go",
        "golang",
        "docker.io/library/golang",
        "actions/setup-go",
        "actions/go-versions"
      ]
    },
    {
      "description": "Group pinned Go quality tooling updates",
      "groupName": "Go quality tooling",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchPackageNames": [
        "github.com/golangci/golangci-lint/v2",
        "golang.org/x/vuln"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The pinned Go quality tooling is invoked as `go run <module>/cmd/...@<version>`. No built-in manager parses that: gomod reads go.mod (these modules are not required there), dockerfile reads FROM, and github-actions reads uses.",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^Dockerfile$/",
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "go run (?<depName>[^@\\s]+?)/cmd/[^@\\s]+@(?<currentValue>v[^\\s\"']+)"
      ],
      "datasourceTemplate": "go"
    }
  ]
}
