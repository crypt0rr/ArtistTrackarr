PUBLIC_URL=http://localhost:8080
# Bind the published port locally by default; set 0.0.0.0 only behind a trusted TLS proxy/firewall.
ARTIST_TRACKARR_BIND=127.0.0.1
SETUP_TOKEN=replace-with-at-least-32-random-characters
APP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
MUSICBRAINZ_CONTACT=you@example.com
POLL_INTERVAL=6h
SPOTIFY_POLL_INTERVAL=24h
# Accepted values are true or false (case-insensitive).
TRUST_PROXY=false
# Comma-separated CIDRs for proxies allowed to set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
# Non-local HTTP requires explicit opt-in; HTTPS is recommended.
# Accepted values are true or false (case-insensitive).
ALLOW_INSECURE_HTTP=false
# Allow notifications to self-hosted LAN services (disabled by default).
# Accepted values are true or false (case-insensitive).
ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
LOG_LEVEL=info
# Set the container's local timezone, for example Europe/Amsterdam.
TZ=UTC
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_MARKET=US
# ITUNES_MARKET=US
